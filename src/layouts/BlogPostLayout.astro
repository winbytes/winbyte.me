---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="post-content">
    <div class="post-nav">
      <a href="/blog" class="back-button">
        <span aria-hidden="true">&larr;</span> back to blog
      </a>
    </div>

    <div class="post-header">
      <div class="post-header-info">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && (
          <p class="post-desc"><em>{frontmatter.description}</em></p>
        )}
        {frontmatter.postDate && (
          <p class="post-meta">
            📅 Posted on: {new Date(frontmatter.postDate).toLocaleDateString("en-US", {
              month: "long",
              day: "numeric",
              year: "numeric",
            })}
          </p>
        )}
      </div>

      {frontmatter.image && frontmatter.image.url && (
        <div class="post-featured-image">
          <img src={frontmatter.image.url} alt={frontmatter.image.alt || frontmatter.title} loading="eager" />
        </div>
      )}
    </div>

    <div class="markdown-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-nav {
    margin-bottom: 1.5rem;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-family: var(--font-family);
    font-weight: 500;
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    background: rgba(13, 19, 34, 0.5);
    border: 1px solid var(--border-card);
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .back-button:hover {
    color: var(--text-heading);
    border-color: var(--border-card-hover);
    background: var(--bg-card-hover);
    text-decoration: none;
  }

  .post-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding-bottom: 1.25rem;
  }

:global(.markdown-body hr) {
    margin: 0.5rem 0 1.25rem !important;
  }


  .post-header-info {
    flex: 1;
    min-width: 0;
  }

  .post-header-info h1 {
    margin: 0 0 0.4rem;
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-desc {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }

  .post-meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
    opacity: 0.85;
  }

  .post-featured-image {
    width: 200px;
    height: 180px;
    flex-shrink: 0;
    border: 1px solid var(--border-card);
    background-color: var(--bg-card);
    padding: 8px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-featured-image img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2px;
    display: block;
  }

  @media screen and (max-width: 635px) {
    .post-header {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 1.25rem;
    }

    .post-featured-image {
      width: 100%;
      height: 180px;
    }
  }

  .markdown-body hr {
    margin: 0.75rem 0 1.25rem;
  }
</style>