---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="post-content">
    <div class="post-header">
      <div class="post-header-info">
        <h1>{frontmatter.title}</h1>
        <p class="post-desc"><em>{frontmatter.description}</em></p>
        <p class="post-meta">
          📅 Posted on: {frontmatter.postDate.toLocaleDateString("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric",
          })}
        </p>
      </div>

      {frontmatter.image && frontmatter.image.url && (
        <div class="post-featured-image">
          <img src={frontmatter.image.url} alt={frontmatter.image.alt} loading="eager" />
        </div>
      )}
    </div>

    <div class="markdown-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .post-header-info {
    flex: 1;
    min-width: 0;
  }

  .post-header-info h1 {
    margin: 0 0 0.4rem;
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-desc {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }

  .post-meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
    opacity: 0.85;
  }

  .post-featured-image {
    width: 200px;
    height: 180px;
    flex-shrink: 0;
    border: 1px solid var(--border-card);
    background-color: var(--bg-card);
    padding: 8px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-featured-image img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2px;
    display: block;
  }

  @media screen and (max-width: 635px) {
    .post-header {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 1.25rem;
    }

    .post-featured-image {
      width: 100%;
      height: 180px;
    }
  }

  .markdown-body hr {
    margin: 1.5rem 0 2rem;
  }
</style>
