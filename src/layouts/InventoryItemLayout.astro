---
import { Image } from 'astro:assets';
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="inventory-content">
    <h1>{frontmatter.title}</h1>
    <p class="item-meta">
      📅 Date Added: {frontmatter.postDate.toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      })}
    </p>
    {frontmatter.image && frontmatter.image.url && (
      <div class="item-featured-image">
        <Image src={frontmatter.image.url} width={450} height={530} alt={frontmatter.image.alt} loading="eager" />
      </div>
    )}
    <p class="item-desc"><em>{frontmatter.description}</em></p>
    <div class="markdown-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .item-meta {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .item-desc {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .item-featured-image {
    float: right;
    width: 32%;
    max-width: 320px;
    margin: 0 0 1.25rem 1.5rem;
    border: 1px solid var(--border-card);
    background-color: var(--bg-card);
    padding: 6px;
    border-radius: 4px;
  }

  .item-featured-image img {
    width: 100%;
    height: auto;
    border-radius: 2px;
    display: block;
  }

  @media screen and (max-width: 635px) {
    .item-featured-image {
      float: none;
      width: 100%;
      max-width: 100%;
      margin: 1rem 0;
    }
  }
</style>