---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;

const specsList = Array.isArray(frontmatter.specs)
  ? frontmatter.specs
  : frontmatter.specs
  ? Object.entries(frontmatter.specs).map(([k, v]) => `${k}: ${v}`)
  : [];

const otherList = Array.isArray(frontmatter.other)
  ? frontmatter.other
  : frontmatter.other
  ? Object.entries(frontmatter.other).map(([k, v]) => `${k}: ${v}`)
  : [];

const hasImage = Boolean(frontmatter.image && frontmatter.image.url);
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="inventory-card">
    <div class="card-header">
      <div class="card-nav">
        <a href="/inventory" class="back-button">
          <span aria-hidden="true">&larr;</span> back to inventory
        </a>
      </div>

      <div class="item-title-block">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="item-desc"><em>{frontmatter.description}</em></p>}
        <p class="item-meta">
          📅 Date Added: {frontmatter.postDate.toLocaleDateString("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric",
          })}
        </p>
      </div>

      <div class="card-nav-spacer" aria-hidden="true"></div>
    </div>

    {(specsList.length > 0 || otherList.length > 0 || hasImage) && (
      <div class="item-showcase">
        {specsList.length > 0 && (
          <div class="item-col item-specs-panel">
            <h3>Hardware Configuration</h3>
            <ul class="specs-list">
              {specsList.map((spec) => (
                <li>{spec}</li>
              ))}
            </ul>
          </div>
        )}

        {otherList.length > 0 && (
          <div class="item-col item-other-panel">
            <h3>{frontmatter.otherTitle || "Other Details"}</h3>
            <ul class="specs-list">
              {otherList.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}

        {hasImage && (
          <div class="item-col item-featured-image">
            <img src={frontmatter.image.url} alt={frontmatter.image.alt || frontmatter.title} loading="eager" />
          </div>
        )}
      </div>
    )}

    <div class="item-body markdown-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .inventory-card {
    background-color: var(--bg-header);
    border: 1px solid var(--border-card);
    border-radius: 4px;
    padding: 2.25rem 2rem 2.5rem;
    margin-top: 0;
    margin-bottom: 2rem;
  }

  .card-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    margin-bottom: 2rem;
  }

  .card-nav {
    display: flex;
    justify-content: flex-start;
    padding-top: 6px;
  }

  .card-nav-spacer {
    display: block;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-family: var(--font-family);
    font-weight: 500;
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    background: rgba(13, 19, 34, 0.5);
    border: 1px solid var(--border-card);
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .back-button:hover {
    color: var(--text-heading);
    border-color: var(--border-card-hover);
    background: var(--bg-card-hover);
    text-decoration: none;
  }

  .item-title-block {
    text-align: center;
  }

  .item-title-block h1 {
    margin: 0 0 0.35rem;
    font-size: 2.5rem;
    font-weight: 300;
    border-bottom: none;
    padding-bottom: 0;
  }

  .item-desc {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.4;
    margin: 0 0 0.4rem;
  }

  .item-meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
    opacity: 0.85;
  }

  .item-showcase {
    display: flex;
    gap: 1.25rem;
    align-items: stretch;
    margin-bottom: 1.75rem;
  }

  .item-specs-panel,
  .item-other-panel {
    flex: 1;
    min-width: 0;
    background-color: rgba(13, 19, 34, 0.45);
    border: 1px solid var(--border-card);
    border-radius: 4px;
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .item-specs-panel h3,
  .item-other-panel h3 {
    margin: 0 0 0.85rem;
    color: var(--text-heading);
    font-size: 1.05rem;
    font-weight: 600;
    font-family: var(--font-family);
    text-align: center;
    border-bottom: 1px solid rgba(97, 119, 146, 0.25);
    padding-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .specs-list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.92rem;
    color: var(--text-main);
    font-family: var(--font-family);
    line-height: 1.6;
    text-align: left;
    list-style-type: disc;
  }

  .specs-list li {
    margin-bottom: 0.35rem;
    text-align: left;
  }

  .specs-list li:last-child {
    margin-bottom: 0;
  }

  .item-featured-image {
    width: 220px;
    flex-shrink: 0;
    background-color: rgba(13, 19, 34, 0.45);
    border: 1px solid var(--border-card);
    border-radius: 4px;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .item-featured-image img {
    max-width: 100%;
    max-height: 220px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2px;
    display: block;
  }

  .item-body {
    border-top: 1px solid var(--border-card);
    margin-top: 2rem;
    padding-top: 1.5rem;
    text-align: left;
  }

  .item-body:empty {
    display: none;
  }

  .item-body p {
    margin: 0.75rem 0;
    color: var(--text-main);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .item-body h2,
  .item-body h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-heading);
    border-bottom: 1px solid rgba(97, 119, 146, 0.25);
    padding-bottom: 0.35rem;
  }

  .item-body ul {
    margin: 0.5rem 0 1.25rem;
    padding-left: 1.5rem;
  }

  .item-body li {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  @media screen and (max-width: 800px) {
    .inventory-card {
      padding: 1.5rem 1.25rem;
    }

    .card-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .card-nav {
      align-self: flex-start;
      padding-top: 0;
    }

    .card-nav-spacer {
      display: none;
    }

    .item-showcase {
      flex-direction: column;
      gap: 1rem;
    }

    .item-featured-image {
      width: 100%;
      height: 220px;
      order: -1;
    }
  }
</style>