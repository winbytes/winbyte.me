---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

const pageTitle = "winbyte | inventory";
const allPosts = await getCollection('inventory');
const sortedPosts = allPosts.sort((a, b) => b.data.postDate.getTime() - a.data.postDate.getTime());
---

<BaseLayout pageTitle={pageTitle}>
  <h1>inventory</h1>
  <p class="section-desc">
    a catalog of the various electronics i own and use!
  </p>
  <section class="inventory-grid">
    {
      sortedPosts.map((post) => {
        const specsList = Array.isArray(post.data.specs)
          ? post.data.specs
          : post.data.specs
          ? Object.entries(post.data.specs).map(([k, v]) => `${k}: ${v}`)
          : [];

        return (
          <a href={`/posts/${post.id}`} class="inventory-item">
            <article>
              <div class="item-top-row">
                <div class="item-header-text">
                  <h2 class="item-title">{post.data.title}</h2>
                  <p class="item-subtitle">{post.data.description}</p>
                  <p class="item-date">
                    Date Added: {new Date(post.data.postDate).toLocaleDateString("en-US", {
                      month: "long",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </p>
                </div>

                <div class="item-image-col">
                  {post.data.image?.url ? (
                    <img
                      src={post.data.image.url}
                      alt={post.data.image.alt || post.data.title}
                      class="item-thumb"
                      loading="lazy"
                    />
                  ) : (
                    <div class="item-thumb-placeholder">
                      <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                      </svg>
                    </div>
                  )}
                </div>
              </div>

              {specsList.length > 0 && (
                <ul class="item-specs">
                  {specsList.map((spec) => (
                    <li>{spec}</li>
                  ))}
                </ul>
              )}
            </article>
          </a>
        );
      })
    }
  </section>
</BaseLayout>

<style>
  .section-desc {
    margin-bottom: 2rem;
    color: var(--text-muted);
  }

  .inventory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .inventory-item {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  .inventory-item:hover {
    text-decoration: none;
  }

  article {
    background-color: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 4px;
    padding: 1.25rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: all 0.15s ease;
  }

  article:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--border-card-hover);
    transform: translateY(-2px);
  }

  .item-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
    margin-bottom: 0.85rem;
  }

  .item-header-text {
    flex: 1;
    min-width: 0;
  }

  .item-title {
    margin: 0 0 0.25rem;
    color: var(--text-heading);
    font-family: var(--font-family);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    border-bottom: none;
    padding-bottom: 0;
  }

  .item-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-family: var(--font-family);
    font-style: italic;
    margin: 0 0 0.35rem;
    line-height: 1.4;
  }

  .item-date {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-family);
    opacity: 0.85;
  }

  .item-image-col {
    flex-shrink: 0;
  }

  .item-thumb {
    width: 85px;
    height: 85px;
    object-fit: contain;
    border: 1px solid var(--border-card);
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.25);
    padding: 4px;
    display: block;
  }

  .item-thumb-placeholder {
    width: 85px;
    height: 85px;
    border: 1px dashed var(--border-card);
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }

  .item-specs {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-main);
    font-family: var(--font-family);
    border-top: 1px solid rgba(97, 119, 146, 0.25);
    padding-top: 0.85rem;
    width: 100%;
  }

  .item-specs li {
    margin-bottom: 0.25rem;
  }

  @media screen and (max-width: 480px) {
    .inventory-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
