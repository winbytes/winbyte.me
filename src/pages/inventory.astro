---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

const pageTitle = "inventory";
const allPosts = await getCollection('inventory');
const sortedPosts = allPosts.sort((a, b) => b.data.postDate.getTime() - a.data.postDate.getTime());
---

<BaseLayout pageTitle={pageTitle}>
  <h1>inventory</h1>
  <p class="section-desc">
    a catalog of the various electronics i own and use!
  </p>
  <section class="inventory-grid">
    {
      sortedPosts.map((post) => (
        <a href={`/posts/${post.id}`} class="inventory-item">
          <article>
            <h2>{post.data.title}</h2>
            <p class="item-date">
              Date Added: {new Date(post.data.postDate).toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
              })}
            </p>
            <p class="item-excerpt">{post.data.description}</p>
          </article>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .section-desc {
    margin-bottom: 2rem;
    color: var(--text-muted);
  }

  .inventory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .inventory-item {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  .inventory-item:hover {
    text-decoration: none;
  }

  article {
    background-color: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 4px;
    padding: 1.25rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: all 0.15s ease;
  }

  article:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--border-card-hover);
    transform: translateY(-2px);
  }

  .inventory-item h2 {
    margin: 0 0 0.5rem;
    color: var(--text-heading);
    font-family: var(--font-family);
    font-size: 1.35rem;
    font-weight: 600;
    border-bottom: none;
    padding-bottom: 0;
  }

  .item-date {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-family);
  }

  .item-excerpt {
    font-size: 0.975rem;
    line-height: 1.55;
    color: var(--text-main);
    font-family: var(--font-family);
    margin: 0;
  }
</style>
