---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

const pageTitle: string = 'winbyte | blog';
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.postDate.getTime() - a.data.postDate.getTime());
---

<BaseLayout pageTitle={pageTitle}>
  <h1>blog</h1>
  <p class="section-desc">
    random things i write about, mostly tech related, as well as some personal stuff.
  </p>
  <section class="blog-list">
    {
      sortedPosts.map((post) => (
        <a href={`/posts/${post.id}`} class="blog-post">
          <article>
            <h2>{post.data.title}</h2>
            <p class="post-date">
              {new Date(post.data.postDate).toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
              })}
            </p>
            <p class="post-excerpt">{post.data.description}</p>
          </article>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .section-desc {
    margin-top: 0.35rem;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .blog-post {
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .blog-post:hover {
    text-decoration: none;
  }

  article {
    background-color: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
    transition: all 0.15s ease;
  }

  article:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--border-card-hover);
    transform: translateY(-2px);
  }

  .blog-post h2 {
    margin: 0 0 0.4rem;
    color: var(--text-heading);
    font-family: var(--font-family);
    font-size: 1.4rem;
    font-weight: 600;
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-date {
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-family);
  }

  .post-excerpt {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-main);
    font-family: var(--font-family);
    margin: 0;
  }
</style>
